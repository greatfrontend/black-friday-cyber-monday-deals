{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product deal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "url",
    "categories",
    "description",
    "offer",
    "couponCodes",
    "validity",
    "latest"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "url": {
      "type": "string",
      "format": "web-url"
    },
    "faviconUrl": {
      "description": "Optional favicon image URL for the website, useful for deals with affiliate redirects.",
      "type": "string",
      "format": "web-url"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./categories.json"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "offer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "couponCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      }
    },
    "validity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "latest": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "addedAt": {
      "description": "Timestamp when the deal was first added to the directory.",
      "type": "string",
      "format": "date-time"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    }
  }
}
