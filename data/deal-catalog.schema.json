{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annual catalog metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "year",
    "title",
    "description",
    "source",
    "lastChecked",
    "hasLatestColumn",
    "categories"
  ],
  "properties": {
    "$schema": {
      "const": "../deal-catalog.schema.json"
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 9999
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "description": {
      "$ref": "#/definitions/text"
    },
    "source": {
      "type": "string",
      "pattern": "^(README\\.md|archives/[0-9]{4}\\.md)$"
    },
    "lastChecked": {
      "description": "Date or timestamp when the catalog was last checked.",
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "calendar-date" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "hasLatestColumn": {
      "type": "boolean"
    },
    "allDealsPlacements": {
      "description": "Move each deal immediately after another in the default All deals view. Apply placements in the order listed.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dealId", "afterDealId"],
        "properties": {
          "dealId": { "$ref": "#/definitions/id" },
          "afterDealId": { "$ref": "#/definitions/id" }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "heading"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "name": {
            "$ref": "#/definitions/text"
          },
          "heading": {
            "$ref": "#/definitions/text"
          },
          "lastDealIds": {
            "description": "Deals placed at the end of this category, in the order listed.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/id"
            }
          }
        }
      }
    },
    "featuredDealIds": {
      "description": "Ordered, maintainer-curated product IDs shown as hero previews. These are not a ranking.",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    }
  }
}
